# The same server with Microsoft Entra ID instead of the development identity.
# Add these to .env. Nothing in the code changes.

# Check every request's token at the door (HTTP 401 without a valid one), then
# verify the caller for each tool call: signed by the tenant, issued for this server.
# audience is this server's application (client) ID and its application ID URI.
EAP_IDENTITY_PROVIDER=jwt
EAP_IDENTITY_OPTIONS={"preset": "entra", "tenant_id": "<tenant-guid>", "audience": ["<mcp-client-id>", "api://<mcp-client-id>"]}

# Decide every call with OPA. Anything but a clear allow is a deny.
EAP_POLICY_PROVIDER=opa
EAP_POLICY_OPTIONS={"url": "http://localhost:8181"}
