# Copy to .env. Everything not set here uses the local profile's defaults:
# rules policy from policies/, registries from registry/, audit to .agentlib/.

# The data the tools read: CSV files in data/, queried through queries/.
AC2_DATA_SOURCES={"ledger": {"kind": "duckdb_csv", "data_dir": "data", "queries_dir": "queries"}}

# An MCP server compiles no graph, so it needs no store for graph state.
AC2_CHECKPOINT_PROVIDER=none

# Accept development tokens issued for this server. A caller that shows no
# token is this development principal.
AC2_IDENTITY_OPTIONS={"audience": "accounts-mcp", "subject": "dev-user", "tenant": "dev-tenant", "roles": ["analyst"]}
