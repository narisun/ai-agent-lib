# Local settings of rmqna. agentlib wrote the same text to .env, which is yours to change
# and is not committed. The tests read this file, not .env.
# A relative path is relative to this file.

# The model. Set the model ID before the first run.
AC2_MODEL_PROVIDER=anthropic

# AC2_MODEL_ID=<model-id>

# Your API key. Set it here in .env only, never in .env.example.
# ANTHROPIC_API_KEY=<api-key>

# Optional model diagnostics: captures conversation content. Use test data.
# AC2_MODEL_TRACE_PATH=.agentlib/model-trace.jsonl

# The registries and the rules every service of the workspace shares.
AC2_REGISTRY_OPTIONS={"agents_path": "../../registry/agents.yaml", "tools_path": "../../registry/mcp-tools.yaml"}

AC2_POLICY_OPTIONS={"path": "../../policies/agentlib/rules/data.yaml"}

# Who a caller without a token is on this machine. Change the roles to see
# what the rules do. This development identity cannot be used when deployed.
AC2_IDENTITY_OPTIONS={"subject": "dev-user", "tenant": "dev-tenant", "roles": ["analyst"]}

# Optional Phoenix tracing: see docs/tracing.md. Keep real keys in private files.
# AC2_PHOENIX_ENABLED=false
# AC2_PHOENIX_CAPTURE_CONTENT=false
# AC2_PHOENIX_ENV_FILE=path/to/phoenix.env
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
# PHOENIX_PROJECT_NAME=agent-lab
# PHOENIX_API_KEY=your-api-key
