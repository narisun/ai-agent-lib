# The agent with Microsoft Entra ID instead of the development identity.
# Add these to .env. Nothing in the code changes.

# Verify the token the chat UI sends (issued for this agent), and exchange it
# for a token bound to each MCP server the agent calls (on-behalf-of). The
# agent lists a server's tools with a token of its own (client credentials).
# client_secret is the NAME of a secret, not its value.
EAP_IDENTITY_PROVIDER=jwt
EAP_IDENTITY_OPTIONS={"preset": "entra", "tenant_id": "<tenant-guid>", "audience": ["<agent-client-id>", "api://<agent-client-id>"], "exchange": {"client_id": "<agent-client-id>", "client_secret": "entra_client_secret"}}

# Locally the secret comes from this variable; on AWS from Secrets Manager.
EAP_SECRET_ENTRA_CLIENT_SECRET=<the agent's client secret>

# The registries name the MCP server's audience (api://<mcp-client-id>) and this
# agent's client ID. See examples/accounts-mcp/registry. Outside local
# development the server's address in the tool registry must be https.
EAP_REGISTRY_OPTIONS={"agents_path": "../accounts-mcp/registry/agents.yaml", "tools_path": "../accounts-mcp/registry/mcp-tools.yaml"}
