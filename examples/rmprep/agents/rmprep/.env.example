# Local settings of rmprep. agentlib wrote the same text to .env, which is yours to change
# and is not committed. The tests read this file, not .env.
# A relative path is relative to this file.

# The model. 'fake' needs no account: it echoes the question, and tests script it.
EAP_MODEL_PROVIDER=fake

EAP_MODEL_ID=fake-model

# Applied only to Anthropic; switch MODEL_PROVIDER and MODEL_ID to use a real model.
EAP_MODEL_OPTIONS={"anthropic": {"prompt_caching": true, "cache_ttl": "5m"}}

# Optional model diagnostics: captures conversation content. Use test data.
# EAP_MODEL_TRACE_PATH=.agentlib/model-trace.jsonl

# Context limits for rmprep: estimated tokens per model request, not per thread.
# The input limit includes tool definitions. Recent history shares the input limit
# with the selected memos, current question and tool results; it is not added to it.
RMPREP_CONTEXT_INPUT_TOKENS=128000
RMPREP_CONTEXT_RECENT_TOKENS=96000
RMPREP_CONTEXT_QUESTION_TOKENS=16000
RMPREP_CONTEXT_TOOL_SCHEMA_TOKENS=4000

# The registries and the rules every service of the workspace shares.
EAP_REGISTRY_OPTIONS={"agents_path": "../../registry/agents.yaml", "tools_path": "../../registry/mcp-tools.yaml"}

EAP_POLICY_OPTIONS={"path": "../../policies/agentlib/rules/data.yaml"}

# Who a caller without a token is on this machine. Change the roles to see
# what the rules do. This development identity cannot be used when deployed.
EAP_IDENTITY_OPTIONS={"subject": "dev-user", "tenant": "dev-tenant", "roles": ["analyst"]}

# Optional separate Langfuse backend: see docs/langfuse-trial.md in the repository.
# Set EAP_LANGFUSE_ENV_FILE to a private settings file in Command Prompt.
# EAP_LANGFUSE_ENABLED=true
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_PROJECT_ID=rmprep-trial
# LANGFUSE_PUBLIC_KEY=your-project-public-key
# LANGFUSE_SECRET_KEY=your-project-secret-key
# EAP_LANGFUSE_CAPTURE_CONTENT=false
