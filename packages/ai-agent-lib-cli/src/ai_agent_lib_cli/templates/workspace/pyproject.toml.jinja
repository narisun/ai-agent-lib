# The {{ name }} workspace. Every agent and MCP server in it is one member.
# The root is not a package: it only holds what the members share.

[project]
name = "{{ name }}"
version = "0.1.0"
description = {{ ("Agents and MCP servers of " ~ owner ~ ", built on ai-agent-lib.") | toml }}
requires-python = ">=3.11"

[tool.uv]
package = false

[tool.uv.workspace]
members = ["agents/*", "mcp-servers/*"]
{% if library.kind == "path" %}

# Optional uv support for the local checkout. The pip-based agentlib install
# command uses the library source recorded in agentlib.toml instead.
[tool.uv.sources]
ai-agent-lib-core = { path = {{ (library.path ~ "/packages/ai-agent-lib-core") | toml }}, editable = true }
ai-agent-lib-aws = { path = {{ (library.path ~ "/packages/ai-agent-lib-aws") | toml }}, editable = true }
ai-agent-lib-cli = { path = {{ (library.path ~ "/packages/ai-agent-lib-cli") | toml }}, editable = true }
{% endif %}

[dependency-groups]
dev = [
    # The agentlib command, to add agents and MCP servers to this workspace.
    "ai-agent-lib-cli{{ library.version or "" }}",
    "mypy>=1.11",
    "pytest>=8.2",
    "pytest-asyncio>=1.4",
    # Tests that reach the network by accident fail instead of passing slowly.
    "pytest-socket>=0.7",
    "ruff>=0.6",
]

[tool.pytest.ini_options]
minversion = "8.0"
testpaths = ["agents", "mcp-servers", "tests"]
addopts = [
    "--import-mode=importlib",
    "--strict-markers",
    "-ra",
    # No test reaches beyond this machine. Loopback stays open: asyncio needs it
    # on Windows, and a test of a local service such as OPA uses it.
    "--allow-hosts=127.0.0.1,::1",
    # Opt in with -m integration or -m eval.
    "-m", "not integration and not eval",
]
markers = [
    "integration: needs something outside the process, such as OPA or a cloud account",
    "eval: runs a real model against a dataset; see evals/ in each agent",
]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"

[tool.ruff]
line-length = 100
target-version = "py311"
src = ["agents/*/src", "mcp-servers/*/src"]

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "SIM", "RUF"]
# The formatter keeps lines short where it can; a long string is not an error.
ignore = ["E501"]

[tool.mypy]
python_version = "3.11"
strict = true
files = ["."]
exclude = ['^\.venv/']
