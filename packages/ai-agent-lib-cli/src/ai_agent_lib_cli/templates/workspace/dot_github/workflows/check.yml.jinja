# Written by agentlib. The gate every change to {{ name }} passes: the same
# 'agentlib check' a developer runs, on Linux and on Windows.
name: check

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  check:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest]
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    steps:
      - uses: actions/checkout@v4
{% if library.kind == "path" %}
      # This workspace installs ai-agent-lib from a checkout on a developer's
      # machine, which CI does not have. Install it from your package index
      # instead (see the comment in pyproject.toml), then delete this step.
      - run: echo "Install ai-agent-lib from a package index to run this workflow." && exit 1
{% endif %}
      - uses: astral-sh/setup-uv@v5
        with:
          python-version: "3.11"
      - run: uv sync --all-packages --locked
      - run: uv run agentlib check
