# The OPA sidecar: the platform's Rego bundle with this workspace's rules as data.
# Build it from the workspace folder:
#   docker build -f deploy/opa/Dockerfile -t opa .
# 'agentlib deploy' copies the bundle to deploy/opa/bundle; run it again after an upgrade.
FROM openpolicyagent/opa:1.0.0-static

COPY deploy/opa/bundle /bundle
COPY policies /policies
# The task's loopback address only: nothing outside the task can ask for a decision.
CMD ["run", "--server", "--addr", "127.0.0.1:8181", "--log-level", "error", "-b", "/bundle", "/policies"]
