"""HTTP entry point: serve the agent until the platform stops it."""

from __future__ import annotations

import argparse
from collections.abc import AsyncIterator, Sequence
from typing import Any

from ai_agent_lib_core import RequestContext, ServiceConfig, ServiceContainer
from ai_agent_lib_core.integrations.http import (
    OutcomeJournal,
    ServiceLifecycle,
    SqliteOutcomeJournal,
    agent_app,
    question_input,
    run_service,
    serve,
)
from ai_agent_lib_core.integrations.langgraph.langfuse import LangfuseTracing, langfuse_tracing

from {{ package }}.graph import APPLICATION, answer, build_graph, steps
from {{ package }}.settings import ENV_FILE

__all__ = ["build_app", "main"]


async def build_app(
    services: ServiceContainer, lifecycle: ServiceLifecycle, *, outcomes: OutcomeJournal | None = None,
    tracing: LangfuseTracing | None = None,
) -> Any:
    """Build the agent's HTTP application.

    The graph is prepared once after the listener starts and before readiness.
    Each request brings its own caller: the entry point turns the bearer token into a
    request context before the graph runs.

    Args:
        services: The container used by request handlers. The lifecycle startup
            callback must start and validate it before graph preparation runs.
        lifecycle: Receives deferred preparation before serving starts.
        tracing: Optional library tracing, owned by the service entry point.
    """
    graph: Any = None

    async def prepare() -> None:
        # Admission stays closed until discovery and graph compilation succeed.
        nonlocal graph
        graph = build_graph(services, await services.registered_mcp_tools(APPLICATION))

    lifecycle.prepare(prepare)

    async def respond(current_graph: Any, container: ServiceContainer,
                      context: RequestContext, question: str) -> dict[str, Any]:
        return {"answer": await answer(current_graph, container, context, question)}

    async def run(context: RequestContext, given: Any) -> dict[str, Any]:
        question = question_input(given)
        if tracing is not None:
            return await tracing.run(graph, services, context, question, respond=respond)
        return await respond(graph, services, context, question)

    async def stream(context: RequestContext, given: Any) -> AsyncIterator[dict[str, Any]]:
        # POST /invoke/stream sends each step as a server-sent event.
        async for step in steps(graph, services, context, question_input(given)):
            yield step

    return agent_app(
        services, run, application=APPLICATION, lifecycle=lifecycle, stream=stream,
        live_updates=True, outcomes=outcomes,
    )


async def _serve(config: ServiceConfig, host: str, port: int) -> None:
    async with langfuse_tracing(APPLICATION, config, dotenv_path=ENV_FILE) as tracing:
        services = ServiceContainer(config, model_trace=tracing)

        async def start() -> None:
            await services.start()
            await services.validate()

        lifecycle = ServiceLifecycle(start)
        try:
            # The listener is available during adapter startup and graph preparation.
            await serve(await build_app(
                services, lifecycle, tracing=tracing,
                outcomes=SqliteOutcomeJournal(ENV_FILE.parent / ".agentlib" / "outcomes.sqlite")
                if config.deployment_env == "local" else None,
            ), lifecycle, host=host, port=port)
        finally:
            await services.aclose()


def main(argv: Sequence[str] | None = None) -> int:
    """Serve until stopped. SIGTERM lets requests in flight finish first."""
    parser = argparse.ArgumentParser(prog="{{ name }}-serve", description=__doc__)
    parser.add_argument("--host", default="127.0.0.1", help="address to listen on")
    parser.add_argument("--port", type=int, default={{ port }}, help="port to listen on")
    arguments = parser.parse_args(argv)
    # Configuration, logging, telemetry and the explanation of a failure are
    # the library's entry-point wiring; this module only says what to serve.
    return run_service(
        APPLICATION,
        lambda config: _serve(config, arguments.host, arguments.port),
        env_file=ENV_FILE,
        program="{{ name }}-serve",
    )


if __name__ == "__main__":
    raise SystemExit(main())
