"""The agent's own tools. Plain functions; the library governs them."""

from __future__ import annotations

__all__ = ["greet"]


def greet(name: str) -> str:
    """Return a greeting for a person, given their name."""
    cleaned = name.strip()
    if not cleaned:
        return "There is nobody to greet: the name is empty."
    return f"Hello, {cleaned}!"
