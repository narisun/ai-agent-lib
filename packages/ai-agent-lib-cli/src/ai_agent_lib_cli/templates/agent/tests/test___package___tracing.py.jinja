"""The two-question walkthrough passes tool results and saved history to the model."""

from __future__ import annotations

import json
from dataclasses import replace
from pathlib import Path

from ai_agent_lib_core import ServiceContainer
from ai_agent_lib_core.pipeline import bind_request_context
from ai_agent_lib_core.testing import calls_tool, load_test_config, scripted_providers

from {{ package }}.examples.trace_anthropic import QUESTIONS, run_two_turns
from {{ package }}.graph import APPLICATION, build_graph

SERVICE = Path(__file__).resolve().parents[1]


async def test_two_questions_share_history_and_the_checkpoint_survives_restart(tmp_path: Path) -> None:
    config = replace(
        load_test_config(SERVICE / ".env.example", state_dir=tmp_path),
        model_trace_path=tmp_path / "model-trace.jsonl",
    )
    history = await run_two_turns(
        config,
        "tracing-test",
        providers=scripted_providers(calls_tool("greet", name="Ada"), "Hello, Ada!", "Your name is Ada."),
    )
    assert [len(turn["messages"]) for turn in history] == [4, 6]
    assert history[0]["request_id"] != history[1]["request_id"]
    assert {turn["thread_id"] for turn in history} == {"tracing-test"}
    assert history[1]["messages"][:4] == history[0]["messages"]
    events = [json.loads(line) for line in (tmp_path / "model-trace.jsonl").read_text(encoding="utf-8").splitlines()]
    assert [event["event"] for event in events] == ["model.request", "model.response"] * 3
    assert [len(event["messages"]) for event in events[::2]] == [2, 4, 6]
    assert events[4]["messages"][1:5] == history[0]["messages"]
    assert events[4]["messages"][-1]["content"] == QUESTIONS[1]
    tool_call = events[1]["response"]["tool_calls"][0]
    result = events[2]["messages"][-1]
    assert tool_call["name"] == "greet" and tool_call["args"] == {"name": "Ada"}
    assert result["tool_call_id"] == tool_call["id"]
    assert "Hello, Ada!" in result["content"]

    # Read the actual SQLite checkpoint after the walkthrough's container closes.
    async with ServiceContainer(config, scripted_providers()) as services:
        graph = build_graph(services)
        context = await services.authenticate(None, application=APPLICATION, thread_id="tracing-test")
        with bind_request_context(context):
            snapshot = await graph.aget_state(services.invocation(context)["config"])
        assert [message.model_dump(mode="json") for message in snapshot.values["messages"]] == history[1]["messages"]
        fresh = await services.authenticate(None, application=APPLICATION, thread_id="new-thread")
        with bind_request_context(fresh):
            empty = await graph.aget_state(services.invocation(fresh)["config"])
        assert not empty.values.get("messages")
