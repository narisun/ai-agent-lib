# One agentlib service on ECS Fargate: the service, an OPA sidecar when it uses
# OPA, and an OpenTelemetry collector sidecar when it sends telemetry.
#
# The task role holds only what the service's adapters declared they need
# (task_policy_json, written by 'agentlib deploy'), plus what the collector
# needs when there is one. The execution role can pull images and write this
# service's logs, nothing else.

data "aws_caller_identity" "current" {}

locals {
  account   = data.aws_caller_identity.current.account_id
  log_group = "/agentlib/${var.name}"
  # The collector's default configuration writes metrics to this log group.
  metrics_log_group = "/aws/ecs/application/metrics"

  logging = {
    logDriver = "awslogs"
    options = {
      awslogs-group         = aws_cloudwatch_log_group.this.name
      awslogs-region        = var.region
      awslogs-stream-prefix = var.name
    }
  }

  sidecars_first = concat(
    var.opa_image == null ? [] : [{ containerName = "opa", condition = "START" }],
    var.collector ? [{ containerName = "collector", condition = "START" }] : [],
  )

  service_container = {
    name                   = "service"
    image                  = var.image
    command                = var.command
    essential              = true
    readonlyRootFilesystem = true
    portMappings           = [{ containerPort = var.port, protocol = "tcp" }]
    environment = [
      for key, value in merge(var.environment, { AWS_REGION = var.region }) :
      { name = key, value = value }
    ]
    mountPoints = [{ sourceVolume = "tmp", containerPath = "/tmp", readOnly = false }]
    dependsOn   = local.sidecars_first
    healthCheck = {
      command = [
        "CMD", "python", "-c",
        "import urllib.request; urllib.request.urlopen('http://127.0.0.1:${var.port}/healthz', timeout=3)",
      ]
      interval    = 15
      timeout     = 5
      retries     = 3
      startPeriod = 30
    }
    logConfiguration = local.logging
  }

  # OPA listens on the task's loopback only: nothing outside the task can ask it.
  opa_container = {
    name                   = "opa"
    image                  = var.opa_image
    essential              = true
    readonlyRootFilesystem = true
    logConfiguration       = local.logging
  }

  # The service sends OTLP over HTTP to localhost:4318, the exporter's default.
  collector_container = {
    name                   = "collector"
    image                  = var.collector_image
    command                = ["--config=/etc/ecs/ecs-default-config.yaml"]
    essential              = false
    readonlyRootFilesystem = true
    logConfiguration       = local.logging
  }

  containers = concat(
    [local.service_container],
    var.opa_image == null ? [] : [local.opa_container],
    var.collector ? [local.collector_container] : [],
  )
}

resource "aws_cloudwatch_log_group" "this" {
  name              = local.log_group
  retention_in_days = var.log_retention_days
  kms_key_id        = var.log_kms_key_arn
  tags              = var.tags
}

# ------------------------------------------------------------------ roles

data "aws_iam_policy_document" "assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["ecs-tasks.amazonaws.com"]
    }
    # Only ECS tasks of this account may take the roles.
    condition {
      test     = "StringEquals"
      variable = "aws:SourceAccount"
      values   = [local.account]
    }
  }
}

resource "aws_iam_role" "execution" {
  name               = "${var.name}-execution"
  assume_role_policy = data.aws_iam_policy_document.assume.json
  tags               = var.tags
}

data "aws_iam_policy_document" "execution" {
  statement {
    sid       = "PullImages"
    actions   = ["ecr:GetAuthorizationToken", "ecr:BatchCheckLayerAvailability", "ecr:GetDownloadUrlForLayer", "ecr:BatchGetImage"]
    resources = ["*"]
  }
  statement {
    sid       = "WriteThisServicesLogs"
    actions   = ["logs:CreateLogStream", "logs:PutLogEvents"]
    resources = ["${aws_cloudwatch_log_group.this.arn}:*"]
  }
}

resource "aws_iam_role_policy" "execution" {
  name   = "pull-and-log"
  role   = aws_iam_role.execution.id
  policy = data.aws_iam_policy_document.execution.json
}

resource "aws_iam_role" "task" {
  name               = "${var.name}-task"
  assume_role_policy = data.aws_iam_policy_document.assume.json
  tags               = var.tags
}

resource "aws_iam_role_policy" "adapters" {
  count  = var.task_policy_json == null ? 0 : 1
  name   = "adapters"
  role   = aws_iam_role.task.id
  policy = var.task_policy_json
}

data "aws_iam_policy_document" "collector" {
  statement {
    sid       = "SendTraces"
    actions   = ["xray:PutTraceSegments", "xray:PutTelemetryRecords", "xray:GetSamplingRules", "xray:GetSamplingTargets"]
    resources = ["*"]
  }
  statement {
    sid     = "SendMetrics"
    actions = ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents", "logs:DescribeLogStreams"]
    resources = [
      "arn:aws:logs:${var.region}:${local.account}:log-group:${local.metrics_log_group}",
      "arn:aws:logs:${var.region}:${local.account}:log-group:${local.metrics_log_group}:*",
    ]
  }
}

resource "aws_iam_role_policy" "collector" {
  count  = var.collector ? 1 : 0
  name   = "collector"
  role   = aws_iam_role.task.id
  policy = data.aws_iam_policy_document.collector.json
}

# ------------------------------------------------------------------ task and service

resource "aws_ecs_task_definition" "this" {
  family                   = var.name
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = var.cpu
  memory                   = var.memory
  execution_role_arn       = aws_iam_role.execution.arn
  task_role_arn            = aws_iam_role.task.arn
  container_definitions    = jsonencode(local.containers)

  runtime_platform {
    operating_system_family = "LINUX"
    cpu_architecture        = var.cpu_architecture
  }

  # The root file systems are read-only; this is the one writable place.
  volume {
    name = "tmp"
  }

  tags = var.tags
}

resource "aws_ecs_service" "this" {
  name            = var.name
  cluster         = var.cluster_arn
  task_definition = aws_ecs_task_definition.this.arn
  desired_count   = var.desired_count
  launch_type     = "FARGATE"
  propagate_tags  = "SERVICE"

  # The service stops taking requests on SIGTERM and finishes those in flight.
  deployment_minimum_healthy_percent = 100
  deployment_maximum_percent         = 200

  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }

  network_configuration {
    subnets          = var.subnet_ids
    security_groups  = var.security_group_ids
    assign_public_ip = false
  }

  dynamic "load_balancer" {
    for_each = var.target_group_arn == null ? [] : [var.target_group_arn]
    content {
      target_group_arn = load_balancer.value
      container_name   = "service"
      container_port   = var.port
    }
  }

  tags = var.tags
}
