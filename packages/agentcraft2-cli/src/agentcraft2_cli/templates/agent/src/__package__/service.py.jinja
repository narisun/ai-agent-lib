"""HTTP entry point: serve the agent until the platform stops it."""

from __future__ import annotations

import dataclasses
from collections.abc import AsyncIterator, Sequence
from typing import Any

from agentcraft2_core import RequestContext, ServiceConfig, ServiceContainer
from agentcraft2_core.integrations.http import (
    AgentService,
    OutcomeJournal,
    ServiceLifecycle,
    SqliteOutcomeJournal,
    build_agent_app,
    run_agent,
)
from agentcraft2_core.integrations.langgraph import AgentTracing

from {{ package }}.graph import APPLICATION, answer, build_graph, steps
from {{ package }}.settings import ENV_FILE, STATE_DIR

__all__ = ["SERVICE", "build_app", "main"]


async def _build_graph(services: ServiceContainer) -> Any:
    # Admission stays closed until discovery and graph compilation succeed.
    return build_graph(services, await services.registered_mcp_tools(APPLICATION))


async def _respond(
    graph: Any, services: ServiceContainer, context: RequestContext, question: str
) -> dict[str, Any]:
    return {"answer": await answer(graph, services, context, question)}


async def _stream(
    graph: Any, services: ServiceContainer, context: RequestContext, given: Any
) -> AsyncIterator[dict[str, Any]]:
    # POST /invoke/stream sends each step as a server-sent event.
    async for step in steps(graph, services, context, SERVICE.question(given)):
        yield step


def _outcomes(config: ServiceConfig) -> OutcomeJournal | None:
    # Local-only: a deployed service gets no durable journal from this library.
    if config.deployment_env == "local":
        return SqliteOutcomeJournal(STATE_DIR / "outcomes.sqlite")
    return None


SERVICE = AgentService(
    application=APPLICATION,
    build_graph=_build_graph,
    respond=_respond,
    stream=_stream,
    default_port={{ port }},
    env_file=ENV_FILE,
    outcomes=_outcomes,
)


async def build_app(
    services: ServiceContainer,
    lifecycle: ServiceLifecycle,
    *,
    outcomes: OutcomeJournal | None = None,
    tracing: AgentTracing | None = None,
    agentcore: bool = False,
) -> Any:
    """Build the agent's HTTP application; kept for callers of the previous shape.

    ``outcomes`` is ``None`` by default here, as it always was for a caller of
    this shape; ``main`` is the only caller that runs the generated service
    for real, and it resolves the durable journal from ``SERVICE.outcomes``
    against the deployment's resolved configuration. ``agentcore`` also serves
    AgentCore Runtime's contract, POST /invocations and GET /ping, beside the
    library's own routes, as ``main --profile agentcore`` does.
    """
    service = dataclasses.replace(
        SERVICE, agentcore=agentcore, app_kwargs={**dict(SERVICE.app_kwargs), "outcomes": outcomes}
    )
    return await build_agent_app(service, services, lifecycle, tracing=tracing)


def main(argv: Sequence[str] | None = None) -> int:
    """Serve until stopped. SIGTERM lets requests in flight finish first.

    ``--profile agentcore`` listens where AgentCore Runtime reaches the container
    (0.0.0.0:8080) and serves its contract too; ``--host`` and ``--port`` override
    the profile's address. Configuration, logging, telemetry, tracing and the
    explanation of a failure are the library's entry-point wiring; this module
    only says what to serve.
    """
    return run_agent(SERVICE, argv)


if __name__ == "__main__":
    raise SystemExit(main())
