"""Command-line entry point: ask the agent one question."""

from __future__ import annotations

import argparse
from collections.abc import Sequence

from agentcraft2_core import ServiceConfig, ServiceContainer
from agentcraft2_core.integrations.http import run_command

from {{ package }}.graph import APPLICATION, ask
from {{ package }}.settings import ENV_FILE

__all__ = ["main"]


async def _run(config: ServiceConfig, question: str, thread_id: str) -> str:
    async with ServiceContainer(config) as services:
        await services.validate()
        # A deployed agent passes the bearer token it was sent. On a developer's
        # machine there is no token: the development identity stands in.
        context = await services.authenticate(None, application=APPLICATION, thread_id=thread_id)
        return await ask(services, context, question)


def main(argv: Sequence[str] | None = None) -> int:
    """Run the agent once and print its answer."""
    parser = argparse.ArgumentParser(prog="{{ name }}", description=__doc__)
    parser.add_argument("question", help="the question to ask")
    parser.add_argument("--thread", default="default", help="conversation to continue")
    arguments = parser.parse_args(argv)
    # The configuration is loaded, the answer printed and a failure explained
    # with its exit code in one place: the library's entry-point wiring.
    return run_command(
        "{{ name }}",
        lambda config: _run(config, arguments.question, arguments.thread),
        env_file=ENV_FILE,
    )


if __name__ == "__main__":
    raise SystemExit(main())
