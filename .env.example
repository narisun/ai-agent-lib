# Generated from the binding table. Do not edit by hand.
# With nothing set, every provider is local: no cloud infrastructure. AC2_PROFILE=aws
# or one AC2_<SECTION>_PROVIDER opts into AWS. Copy to .env and uncomment what you need.
# Variables were previously spelled EAP_*; the old spellings keep working for one minor release
# and warn.

# Default adapter set: local or aws.
# Default: local
# AC2_PROFILE=local

# Where the process runs: local, dev or prod. Drives the one-way guard.
# Default: local
# AC2_DEPLOYMENT_ENV=local

# Operational traces and metrics: off or opentelemetry.
# Default: off
# AC2_TELEMETRY=off

# Optional JSONL file for diagnostic model requests and responses.
# Default: disabled
# AC2_MODEL_TRACE_PATH=.agentlib/model-trace.jsonl

# JSON timeouts, retries and budgets of governed calls.
# Default: model: 120 s, 2 retries; tool: 60 s, 1 retry; budget: 50 model calls and 100 tool calls per request
# AC2_LIMITS={"budget": {"model_calls": 20}}

# Enterprise CA file for the Bedrock clients.
# Default: not set
# AC2_TLS_CA_BUNDLE=

# Provider of the default model alias.
# Default: local: anthropic, aws: bedrock
# AC2_MODEL_PROVIDER=anthropic

# Model behind the default alias.
# Default: not set: required before services.model()
# AC2_MODEL_ID=

# JSON map of further aliases, e.g. {"fast": {"model_id": "..."}}.
# Default: {}: only the default alias
# AC2_MODEL_ALIASES=

# Adapter that serves the secrets section.
# Default: local: env, aws: secrets_manager
# AC2_SECRETS_PROVIDER=

# JSON options for the secrets adapter.
# Default: {}: the adapter's defaults
# AC2_SECRETS_OPTIONS={}

# Adapter that serves the audit section.
# Default: local: jsonl, aws: firehose
# AC2_AUDIT_PROVIDER=

# JSON options for the audit adapter.
# Default: {}: the adapter's defaults
# AC2_AUDIT_OPTIONS={}

# Adapter that serves the identity section.
# Default: local: static, aws: jwt
# AC2_IDENTITY_PROVIDER=

# JSON options for the identity adapter.
# Default: {}: the adapter's defaults
# AC2_IDENTITY_OPTIONS={}

# Adapter that serves the checkpoint section.
# Default: local: sqlite, aws: postgres
# AC2_CHECKPOINT_PROVIDER=

# JSON options for the checkpoint adapter.
# Default: {}: the adapter's defaults
# AC2_CHECKPOINT_OPTIONS={}

# Adapter that serves the registry section.
# Default: local: file, aws: s3_file
# AC2_REGISTRY_PROVIDER=

# JSON options for the registry adapter.
# Default: {}: the adapter's defaults
# AC2_REGISTRY_OPTIONS={}

# Adapter that serves the policy section.
# Default: local: rules, aws: opa
# AC2_POLICY_PROVIDER=

# JSON options for the policy adapter.
# Default: {}: the adapter's defaults
# AC2_POLICY_OPTIONS={}

# Adapter that serves the guardrails section.
# Default: local: patterns, aws: bedrock
# AC2_GUARDRAILS_PROVIDER=

# JSON options for the guardrails adapter.
# Default: {}: the adapter's defaults
# AC2_GUARDRAILS_OPTIONS={}

# JSON options keyed by model provider name.
# Default: {}: each provider's defaults; Anthropic prompt caching is off
# AC2_MODEL_OPTIONS=

# JSON map of named data sources, e.g. {"accounts": {"kind": "duckdb_csv", "data_dir": "data", "queries_dir": "queries"}}.
# Default: {}: no data sources
# AC2_DATA_SOURCES=

# AWS named profile, for example one signed in through SSO.
# Default: not set
# AWS_PROFILE=

# AWS region.
# Default: not set
# AWS_REGION=

# CA file for AWS clients.
# Default: not set
# AWS_CA_BUNDLE=

# Set by AWS inside ECS, Fargate and Lambda. A process that has it must name its deployment environment as dev or prod.
# Default: not set
# AWS_EXECUTION_ENV=

# Outbound proxy.
# Default: not set
# HTTPS_PROXY=

# Hosts that bypass the proxy.
# Default: not set
# NO_PROXY=

# API key for the anthropic model provider.
# Default: not set
# ANTHROPIC_API_KEY=

# A named secret for the env secrets adapter. AC2_SECRET_RATES_TOKEN supplies the secret rates_token.
# AC2_SECRET_<NAME>=

# Optional Phoenix tracing: see docs/phoenix-trial.md. Keep real keys in private files.
# EAP_PHOENIX_ENABLED=false
# EAP_PHOENIX_CAPTURE_CONTENT=false
# EAP_PHOENIX_ENV_FILE=path/to/phoenix.env
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006
# PHOENIX_PROJECT_NAME=agent-lab
# PHOENIX_API_KEY=your-api-key
